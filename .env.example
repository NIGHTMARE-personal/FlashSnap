# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' in the root directory for local development:
#   cp .env.example .env
#
# DO NOT commit your actual '.env' file containing real secret keys to GitHub.
# The '.env' file is already excluded in .gitignore.
# ==============================================================================

# Gemini AI API Key (Required for AI Handwriting OCR, flashcard extraction, and problem solving)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

